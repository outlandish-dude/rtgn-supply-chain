    "info": {
      "author": "Donald Stufft",
      "author_email": "donald@stufft.io",
      "bugtrack_url": null,
      "classifiers": [
        "Programming Language :: Python :: 2",
        "Programming Language :: Python :: 2.6",
        "Programming Language :: Python :: 2.7",
        "Programming Language :: Python :: 3",
