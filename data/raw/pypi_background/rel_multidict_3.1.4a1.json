    "info": {
      "author": "Andrew Svetlov",
      "author_email": "andrew.svetlov@gmail.com",
      "bugtrack_url": null,
      "classifiers": [
        "Development Status :: 5 - Production/Stable",
        "Intended Audience :: Developers",
