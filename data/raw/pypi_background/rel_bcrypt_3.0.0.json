    "info": {
      "author": "The Python Cryptographic Authority developers",
      "author_email": "cryptography-dev@python.org",
      "bugtrack_url": null,
      "classifiers": [
        "Programming Language :: Python :: 2",
        "Programming Language :: Python :: 2.6",
